{
  "name": "super-maths-cp",
  "version": "1.0.0",
  "description": "Progressive Web App for CP maths, now served via Node.js/Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "build": "npm run build:css",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:vitest": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.33.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.0.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.0.0",
    "prettier": "^3.9.6",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.19",
    "vercel": "^58.4.4",
    "vitest": "^4.1.10"
  }
}
